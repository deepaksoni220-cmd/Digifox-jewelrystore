{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": "dist/client",
  "functions": {
    "api/server.js": {
      "includeFiles": "dist/server/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/ring.glb",
      "destination": "/ring.glb"
    },
    {
      "source": "/products/(.*)",
      "destination": "/products/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/server.js"
    }
  ]
}
